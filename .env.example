# Cognitive AI Learning Platform - Environment Configuration
# Copy this file to .env and adjust values as needed

# Application Settings
APP_APP_NAME="Cognitive AI Learning Platform"
APP_APP_VERSION="1.0.0"
APP_DEBUG=false

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM Settings (Ollama)
# Make sure Ollama is running locally with the specified model
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen2.5:1.5b
APP_LLM_TEMPERATURE=0.1
APP_LLM_TIMEOUT=120

# File Upload Settings
APP_MAX_FILE_SIZE_MB=10
APP_MIN_EXTRACTED_TEXT_LENGTH=100
# Supported formats: .pdf, .ppt, .pptx, .doc, .docx (hardcoded in config)

# Cache Settings
APP_CACHE_DIR=cache

# Quiz Settings
APP_QUIZ_QUESTIONS_COUNT=5
APP_QUIZ_OPTIONS_COUNT=4
APP_QUIZ_EXPLANATION_MAX_LENGTH=200
APP_QUIZ_HISTORY_RETENTION=2

# Analytics Settings
# Modules with accuracy below this threshold are considered weak areas
APP_WEAK_AREA_THRESHOLD=60.0

# Logging Settings
APP_LOG_LEVEL=INFO
# Log format is hardcoded in config.py
